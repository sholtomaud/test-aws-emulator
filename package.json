{
  "name": "vendor-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Vendor Tracker: native web components + Lambda + DynamoDB + Cognito, deployed with AWS CDK and tested against AWS Emulator",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-frontend.ts",
    "test:unit": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/unit.xml \"test/unit/**/*.test.ts\"",
    "test:functional": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/functional.xml \"test/functional/**/*.test.ts\"",
    "test:smoke": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/smoke.xml \"test/smoke/**/*.test.ts\"",
    "test:e2e": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/e2e.xml \"test/e2e/**/*.test.ts\"",
    "gateway": "node scripts/local-gateway.ts",
    "cdk": "cdk"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1168.0",
    "@aws-sdk/lib-dynamodb": "^3.1168.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1168.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1168.0",
    "@aws-sdk/client-lambda": "^3.1168.0",
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/client-secrets-manager": "^3.1169.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "aws-cdk": "^2.1148.1",
    "aws-cdk-lib": "^2.277.0",
    "cdk-nag": "^3.0.2",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "playwright": "1.63.0",
    "typescript": "^7.0.2"
  }
}
